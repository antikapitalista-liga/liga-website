---
import "../styles/site.css";
import Navigation from "../components/Navigation.astro";
import SiteIdentity from "../components/SiteIdentity.astro";
import CurrentLinks from "../components/CurrentLinks.astro";

interface Props {
	title: string;
	description: string;
	lang?: "hu" | "en";
	frame?: "brand-rail" | "wide";
	theme?: "default" | "magazine";
	brandLabel?: string;
	brandTone?: "default" | "bronze" | "teal" | "rust" | "navy";
}

const { title, description, lang = "hu", frame = "brand-rail", theme = "default", brandLabel, brandTone = "default" } = Astro.props;
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<title>{title}</title>
	</head>
	<body>
		<Navigation wide={frame === "wide"} magazine={theme === "magazine"} />
		{frame === "wide" ? (
			<slot />
		) : (
			<div class:list={["site-layout", brandTone !== "default" && `site-layout-${brandTone}`, theme === "magazine" && "site-layout-magazine"]}>
				<aside class="site-brand" aria-label={brandLabel ?? (lang === "en" ? "Organization" : "Szervezet")}>
					<slot name="brand"><SiteIdentity lang={lang} /></slot>
				</aside>
				<div class="site-content">
					<slot />
				</div>
				<aside class="site-context" aria-label={lang === "en" ? "Current affairs" : "Aktuális"}>
					<section class="site-context-panel">
						<h2><a href="/magazin/aktualis/">{lang === "en" ? "Current" : "Aktuális"}</a></h2>
						<CurrentLinks lang={lang} />
					</section>
				</aside>
			</div>
		)}
	</body>
</html>
