---
import MainLayout from "./MainLayout.astro";

interface Props {
	title: string;
	description: string;
	topId?: string;
}

const { title, description, topId } = Astro.props;
---

<MainLayout title={`${title} | Antikapitalista Liga Magyarország`} description={description} brandTone="bronze">
	<header class="mission-document-header" id={topId}>
		<div class="constitution-parent"><a href="/kuldetes/">Küldetés</a></div>
		<h1 class="constitution-title">{title}</h1>
	</header>
	<main class="mission-document-content">
		<slot />
	</main>
</MainLayout>

<style>
	.mission-document-header {
		padding-bottom: 0;
		scroll-margin-top: var(--site-nav-height);
	}

	.mission-document-header .constitution-title {
		margin: 20px 0 0;
		overflow-wrap: anywhere;
	}

	.mission-document-content :global(p) {
		max-width: 84ch;
	}

	.mission-document-content :global(.document-chapter-heading) {
		scroll-margin-top: calc(var(--site-nav-height) + 16px);
	}

	@media (max-width: 760px) {
		.mission-document-header,
		.mission-document-content :global(.document-chapter-heading) {
			scroll-margin-top: 120px;
		}
	}
</style>
