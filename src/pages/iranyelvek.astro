---
import mammoth from "mammoth";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import MainLayout from "../layouts/MainLayout.astro";
import DocumentColophon from "../components/DocumentColophon.astro";

const documentBuffer = await readFile(resolve(process.cwd(), "src", "docs", "Irányelvek.docx"));
const { value: guidelinesHtml } = await mammoth.convertToHtml({ buffer: documentBuffer });

const contents = [];
let inQuestionListSection = false;
const guidelinesContent = guidelinesHtml.replace(
	/<h([1-6])>([\s\S]*?)<\/h\1>|<ul>([\s\S]*?)<\/ul>|<p>([\s\S]*?)<\/p>/g,
	(match, headingLevel, headingHtml, listHtml, paragraphHtml) => {
		if (headingLevel) {
			const label = headingHtml
				.replace(/<[^>]*>/g, "")
				.replace(/&amp;/g, "&")
				.replace(/&lt;/g, "<")
				.replace(/&gt;/g, ">")
				.replace(/&quot;/g, '"')
				.replace(/&#39;/g, "'")
				.trim();
			const slug = label
				.toLowerCase()
				.normalize("NFD")
				.replace(/[\u0300-\u036f]/g, "")
				.replace(/[^a-z0-9]+/g, "-")
				.replace(/^-|-$/g, "");
			const id = `iranyelvek-${slug}-${contents.length + 1}`;
			contents.push({ id, level: Number(headingLevel), label });
			inQuestionListSection = label.toLowerCase().includes("vázlatos kérdéskörök");
			const heading = headingHtml.replace(/<\/?strong>/g, "");
			const questionHeadingClass = /^\d+\.5\b/.test(label) ? ' class="question-topics-heading"' : "";
			return `<h${headingLevel} id="${id}"${questionHeadingClass}>${heading}</h${headingLevel}>`;
		}

		if (listHtml !== undefined) {
			return inQuestionListSection
				? `<ul class="question-list">${listHtml}</ul>`
				: `<ul>${listHtml.replace(/<\/?strong>/g, "")}</ul>`;
		}

		if (paragraphHtml.includes("Egy problémát nem lehet ugyanazzal a gondolkodásmóddal megoldani")) {
			return "";
		}

		return `<p>${paragraphHtml.replace(/<\/?strong>/g, "")}</p>`;
	},
);
---

<MainLayout
	title="Irányelvek | Antikapitalista Liga Magyarország"
	description="Híd a Pártalkotmány és a mindenkori Program között."
	frame="wide"
>
	<header class="guidelines-page-header">
		<p class="guidelines-rail-brand">Antikapitalista Liga Magyarország</p>
		<div class="guidelines-title-block">
			<h1 class="guidelines-title">
				Irányelvek (Híd a Pártalkotmány és a mindenkori Program között)
			</h1>
			<blockquote class="guidelines-motto">
				<p>„Egy problémát nem lehet ugyanazzal a gondolkodásmóddal megoldani, amellyel létrehoztuk.”</p>
				<cite>Albert Einstein</cite>
			</blockquote>
		</div>
	</header>

	<main class="guidelines-layout">
		<nav class="guidelines-toc" aria-labelledby="guidelines-toc-title">
			<h2 class="guidelines-toc-title" id="guidelines-toc-title">Tartalom</h2>
			<ol>
				{contents.map((item) => (
					<li class:list={[`toc-level-${item.level}`]}>
						<a href={`#${item.id}`}>{item.label}</a>
					</li>
				))}
			</ol>
		</nav>
		<div class="guidelines-reading-column">
			<article class="guidelines-copy" set:html={guidelinesContent}></article>
			<DocumentColophon />
		</div>
	</main>
</MainLayout>

<style>
	.guidelines-page-header {
		position: sticky;
		top: var(--site-nav-height, 62px);
		z-index: 30;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		box-sizing: border-box;
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 12px 32px 14px calc(16px + clamp(250px, 20vw, 360px) + 24px);
		border-bottom-color: transparent;
		background: linear-gradient(
			to right,
			transparent 0,
			transparent calc(16px + clamp(250px, 20vw, 360px)),
			#f6f8f6 calc(16px + clamp(250px, 20vw, 360px)),
			#f6f8f6 100%
		);
	}

	.guidelines-rail-brand {
		position: absolute;
		top: 14px;
		left: 16px;
		width: calc(16px + clamp(250px, 20vw, 360px) - 32px);
		margin: 0;
		color: var(--color-moss-light);
		font-family: "Calibri Light", "Segoe UI Light", sans-serif;
		font-size: 1.8rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		line-height: 1.12;
	}

	.guidelines-page-header::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: calc(16px + clamp(250px, 20vw, 360px));
		height: 1px;
		background: #d9e1dc;
		content: "";
		pointer-events: none;
	}

	.guidelines-page-header :global(.site-identity) {
		display: none;
	}

	.guidelines-title-block {
		grid-column: 1 / -1;
		width: 100%;
	}

	.guidelines-title {
		margin: 0 0 4px;
		font-size: 1.8rem;
		font-weight: 600;
		line-height: 1.15;
		white-space: nowrap;
	}

	.guidelines-subtitle {
		margin: 0;
		color: #5a3c1e;
		font-family: "Calibri Light", "Segoe UI Light", sans-serif;
		font-size: 1rem;
	}

	.guidelines-motto {
		margin: 12px 0 0;
		padding: 0;
		color: #5a3c1e;
		font-size: 0.95rem;
		font-style: italic;
		line-height: 1.4;
	}

	.guidelines-motto p {
		max-width: none;
		margin: 0 0 4px;
	}

	.guidelines-motto cite {
		font-size: 0.85rem;
		font-style: normal;
	}

	.guidelines-layout {
		position: relative;
		z-index: 0;
		isolation: isolate;
		display: grid;
		grid-template-columns: minmax(0, clamp(250px, 20vw, 360px)) minmax(0, 1fr);
		align-items: start;
		gap: 24px;
		box-sizing: border-box;
		width: 100%;
		max-width: none;
		margin-inline: 0;
		padding-inline: 16px 32px;
	}

	.guidelines-layout::before {
		position: fixed;
		z-index: -1;
		top: 0;
		bottom: 0;
		left: 0;
		width: calc(16px + clamp(250px, 20vw, 360px));
		background: var(--color-moss-deep);
		content: "";
		pointer-events: none;
	}

	.guidelines-toc {
		position: sticky;
		top: calc(var(--site-nav-height, 62px) + 169px);
		box-sizing: border-box;
		max-height: calc(100vh - var(--site-nav-height, 62px) - 185px);
		overflow-y: auto;
		padding: 0 16px 16px;
		background: transparent;
		color: var(--color-moss-light);
	}

	.guidelines-toc-title {
		margin: 0 0 16px;
		color: #e3c37b;
		font-size: 1.4rem;
		line-height: 1.2;
	}

	.guidelines-toc ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.guidelines-toc li {
		margin: 0 0 6px;
		font-size: 0.88rem;
		line-height: 1.35;
	}

	.guidelines-toc .toc-level-2 {
		padding-left: 12px;
		font-size: 0.82rem;
	}

	.guidelines-toc a {
		color: var(--color-moss-light);
		text-decoration: none;
	}

	.guidelines-toc a:hover {
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.guidelines-toc .toc-level-1 {
		font-weight: 600;
	}

	.guidelines-reading-column {
		min-width: 0;
	}

	:global(.guidelines-copy > p:first-child) {
		display: none;
	}

	:global(.guidelines-copy h1),
	:global(.guidelines-copy h2) {
		color: #5a3c1e;
		font-family: "Calibri Light", "Segoe UI Light", sans-serif;
		font-weight: 400;
	}

	:global(.guidelines-copy h1) {
		margin-top: 2em;
		font-size: 1.8rem;
	}

	:global(.guidelines-copy h2) {
		margin-top: 1.5em;
		max-width: 38ch;
		overflow-wrap: anywhere;
		font-size: 1.35rem;
	}

	:global(.guidelines-copy .question-topics-heading) {
		max-width: 32ch;
	}

	:global(.guidelines-copy h1),
	:global(.guidelines-copy h2) {
		scroll-margin-top: 300px;
	}

	:global(.guidelines-copy) {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}

	:global(.guidelines-copy p) {
		max-width: 84ch;
	}

	:global(.guidelines-copy .question-list > li) {
		max-width: 84ch;
		overflow-wrap: anywhere;
	}

	:global(.guidelines-copy strong) {
		font-weight: 400;
	}

	:global(.guidelines-copy .question-list strong) {
		font-weight: 600;
	}

	@media (max-width: 760px) {
		.guidelines-page-header {
			display: flex;
			flex-direction: column;
			gap: 10px;
			padding: 10px 16px 12px;
			border-bottom-color: #d9e1dc;
			background: #f6f8f6;
		}

		.guidelines-rail-brand {
			position: static;
			width: auto;
			color: #5a3c1e;
			font-size: 1.35rem;
		}

		.guidelines-page-header::after {
			display: none;
		}

		.guidelines-title {
			font-size: 1.3rem;
			white-space: normal;
		}

		.guidelines-layout {
			grid-template-columns: minmax(0, 1fr);
			gap: 16px;
			width: calc(100% - 32px);
			margin-inline: auto;
			padding: 0;
		}

		.guidelines-layout::before {
			display: none;
		}

		.guidelines-toc {
			position: static;
			max-height: 320px;
			border-radius: 4px;
			background: var(--color-moss-deep);
		}

		:global(.guidelines-copy h1),
		:global(.guidelines-copy h2) {
			scroll-margin-top: 320px;
		}
	}
</style>
