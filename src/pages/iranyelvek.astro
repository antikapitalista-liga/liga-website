---
import mammoth from "mammoth";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import MainLayout from "../layouts/MainLayout.astro";
import DocumentColophon from "../components/DocumentColophon.astro";
import SiteLogo from "../components/SiteLogo.astro";

const documentBuffer = await readFile(resolve(process.cwd(), "src", "docs", "Irányelvek.docx"));
const { value: guidelinesHtml } = await mammoth.convertToHtml({ buffer: documentBuffer });

interface TocItem {
	id: string;
	level: number;
	label: string;
}

const contents: TocItem[] = [];
let inQuestionListSection = false;
const guidelinesContentWithHeadings = guidelinesHtml.replace(
	/<h([1-6])>([\s\S]*?)<\/h\1>|<ul>([\s\S]*?)<\/ul>|<p>([\s\S]*?)<\/p>/g,
	(match, headingLevel, headingHtml, listHtml, paragraphHtml) => {
		if (headingLevel) {
			const label = headingHtml
				.replace(/<[^>]*>/g, "")
				.replace(/&amp;/g, "&")
				.replace(/&lt;/g, "<")
				.replace(/&gt;/g, ">")
				.replace(/&quot;/g, '"')
				.replace(/&#39;/g, "'")
				.trim();
			const slug = label
				.toLowerCase()
				.normalize("NFD")
				.replace(/[\u0300-\u036f]/g, "")
				.replace(/[^a-z0-9]+/g, "-")
				.replace(/^-|-$/g, "");
			const id = `iranyelvek-${slug}-${contents.length + 1}`;
			contents.push({ id, level: Number(headingLevel), label });
			inQuestionListSection = label.toLowerCase().includes("vázlatos kérdéskörök");
			const heading = headingHtml.replace(/<\/?strong>/g, "");
			const classes = [
				headingLevel === "1" && "document-chapter-heading",
				/^\d+\.5\b/.test(label) && "question-topics-heading",
			].filter(Boolean).join(" ");
			const headingClass = classes ? ` class="${classes}"` : "";
			return `<h${headingLevel} id="${id}"${headingClass}>${heading}</h${headingLevel}>`;
		}

		if (listHtml !== undefined) {
			return inQuestionListSection
				? `<ul class="question-list">${listHtml}</ul>`
				: `<ul>${listHtml.replace(/<\/?strong>/g, "")}</ul>`;
		}

		if (paragraphHtml.includes("Egy problémát nem lehet ugyanazzal a gondolkodásmóddal megoldani")) {
			return "";
		}

		return `<p>${paragraphHtml.replace(/<\/?strong>/g, "")}</p>`;
	},
);

const guidelinesContent = guidelinesContentWithHeadings.replace(
	/<h([1-6]) id="([^"]+)"([^>]*)>([\s\S]*?)<\/h\1>/g,
	(match, level, id, attributes, heading) => {
		const index = contents.findIndex((item) => item.id === id);
		const previous = contents[index - 1];
		const next = contents[index + 1];
		const controls = [
			previous && `<a href="#${previous.id}" aria-label="Ugrás az előző fejezetre">↑</a>`,
			next && `<a href="#${next.id}" aria-label="Ugrás a következő fejezetre">↓</a>`,
			level === "1" && '<a href="#guidelines-top" aria-label="Ugrás a dokumentum elejére">↑↑</a>',
		].filter(Boolean).join("");
		return `<h${level} id="${id}"${attributes}>${heading}<span class="guidelines-chapter-controls" role="group" aria-label="Fejezetnavigáció">${controls}</span></h${level}>`;
	},
);
---

<MainLayout
	title="Irányelvek | Antikapitalista Liga Magyarország"
	description="Híd a Pártalkotmány és a mindenkori Program között."
	brandLabel="Tartalomjegyzék"
	brandTone="bronze"
>
	<div slot="brand" class="guidelines-sidebar">
		<div class="guidelines-sidebar-heading">
			<SiteLogo />
			<p class="guidelines-sidebar-title">Irányelvek</p>
			<p class="guidelines-sidebar-subtitle">Híd a Pártalkotmány és a mindenkori Program között</p>
		</div>
		<nav class="guidelines-toc" aria-labelledby="guidelines-toc-title">
			<h2 class="guidelines-toc-title" id="guidelines-toc-title">Tartalom</h2>
			<ol>
				{contents.map((item) => (
					<li class:list={[`toc-level-${item.level}`]}>
						<a href={`#${item.id}`}>{item.label}</a>
					</li>
				))}
			</ol>
		</nav>
	</div>
	<header class="guidelines-page-header" id="guidelines-top">
		<div class="constitution-parent"><a href="/kuldetes/">Küldetés</a></div>
		<h1 class="guidelines-title">Irányelvek</h1>
		<p class="guidelines-subtitle">Híd a Pártalkotmány és a mindenkori Program között</p>
	</header>

	<main class="guidelines-layout">
		<div class="guidelines-reading-column">
			<article class="guidelines-copy" set:html={guidelinesContent}></article>
			<DocumentColophon />
		</div>
	</main>
</MainLayout>

<style>
	.guidelines-page-header {
		padding-bottom: 0;
		scroll-margin-top: var(--site-nav-height);
	}

	.guidelines-page-header .guidelines-title {
		margin: 20px 0 0;
	}

	.guidelines-subtitle {
		margin: 10px 0 24px;
		color: var(--color-rail);
		font-family: "Crayon Libre", "Calibri Light", "Segoe UI Light", sans-serif;
		font-size: 1.5rem;
		font-variant: small-caps;
		line-height: 1.25;
	}

	.guidelines-sidebar-heading {
		text-align: left;
	}

	@media (min-width: 1101px) {
		.guidelines-sidebar {
			padding-top: calc(var(--site-nav-height) + 22px - 73px);
		}
	}

	.guidelines-sidebar-title {
		margin: 0 0 4px;
		font-size: 1.2rem;
	}

	.guidelines-sidebar-subtitle {
		margin: 0 0 20px;
		font-size: 0.9rem;
		line-height: 1.4;
	}

	.guidelines-toc {
		text-align: left;
	}

	.guidelines-toc-title {
		margin: 0 0 12px;
		color: var(--color-moss-light);
		font-size: 1.2rem;
	}

	.guidelines-toc ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.guidelines-toc li {
		margin: 0 0 8px;
		font-size: 0.82rem;
		line-height: 1.35;
	}

	.guidelines-toc .toc-level-2 {
		padding-left: 12px;
		font-size: 0.78rem;
	}

	.guidelines-toc a {
		color: var(--color-moss-light);
		text-decoration: none;
	}

	.guidelines-toc a:hover {
		color: #f9d99b;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.guidelines-toc .toc-level-1 {
		font-weight: 600;
	}

	.guidelines-reading-column {
		min-width: 0;
	}

	:global(.guidelines-copy > p:first-child) {
		display: none;
	}

	:global(.guidelines-copy h2) {
		color: var(--color-rail);
		font-family: "Crayon Libre", "Calibri Light", "Segoe UI Light", sans-serif;
		font-weight: 400;
		margin-top: 1.5em;
		font-size: 2rem;
		line-height: 1.25;
		overflow-wrap: anywhere;
		text-transform: uppercase;
	}

	:global(.guidelines-copy h2) {
		margin-top: 0.8em;
		font-size: 1.5rem;
	}

	:global(.guidelines-chapter-controls) {
		display: inline-flex;
		gap: 0.35em;
		margin-left: 1em;
		white-space: nowrap;
		font-size: 0.75em;
	}

	:global(.guidelines-chapter-controls a) {
		padding: 0 0.2em;
		border-radius: 4px;
		color: inherit;
		text-decoration: none;
	}

	:global(.guidelines-chapter-controls a:hover) {
		background: rgb(0 0 0 / 12%);
	}

	:global(.guidelines-copy h1),
	:global(.guidelines-copy h2) {
		scroll-margin-top: calc(var(--site-nav-height) + 16px);
	}

	:global(.guidelines-copy) {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}

	:global(.guidelines-copy p) {
		max-width: 84ch;
	}

	:global(.guidelines-copy .question-list > li) {
		max-width: 84ch;
		overflow-wrap: anywhere;
	}

	:global(.guidelines-copy strong) {
		font-weight: 400;
	}

	:global(.guidelines-copy .question-list strong) {
		font-weight: 600;
	}

	@media (max-width: 1100px) {
		.guidelines-toc {
			max-height: 320px;
			overflow-y: auto;
		}

		.guidelines-subtitle {
			font-size: 1.2rem;
		}

		:global(.guidelines-copy h2) {
			font-size: 1.2rem;
		}
	}

	@media (max-width: 760px) {
		.guidelines-page-header {
			scroll-margin-top: 120px;
		}

		:global(.guidelines-copy h1),
		:global(.guidelines-copy h2) {
			scroll-margin-top: 120px;
		}
	}
</style>
