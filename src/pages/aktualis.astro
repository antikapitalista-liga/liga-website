---
import MainLayout from "../layouts/MainLayout.astro";
import CurrentAnnouncement from "../components/CurrentAnnouncement.astro";
import CurrentCategoryDescription from "../components/CurrentCategoryDescription.astro";
import CurrentNews from "../components/CurrentNews.astro";
import { aktualisCategories, articlesByCategory, getRecentArticles } from "../data/aktualis";
---

<MainLayout
	title="Aktuális | Antikapitalista Liga Magyarország"
	description="Párthírek, hirdetmények, események és alternatív hírek az Antikapitalista Liga Magyarország oldalán."
	theme="current"
>
	<header class="current-overview-header">
		<h1 class="main-page-title">Aktuális</h1>
	</header>
	<main class="current-overview">
		{aktualisCategories.map((category) => (
			<section id={category.slug} aria-labelledby={`${category.slug}-title`}>
				<h2 class="current-category-title" id={`${category.slug}-title`}>
					<a href={`/aktualis/${category.slug}/`}>{category.label}</a>
				</h2>
				{category.description && <CurrentCategoryDescription text={category.description} />}
				{category.slug === "hirdetmenyek" && <CurrentAnnouncement />}
				{getRecentArticles(articlesByCategory[category.slug] ?? []).map((article) => (
					<CurrentNews article={article} />
				))}
				{!articlesByCategory[category.slug]?.length && category.slug !== "hirdetmenyek" && category.slug !== "part-hirek" && (
					<p>A rovat írásai hamarosan itt lesznek elérhetők.</p>
				)}
			</section>
		))}
	</main>
</MainLayout>

<style>
	.current-overview-header h1 {
		margin-bottom: 0;
	}

	.current-overview section:first-child h2 {
		margin-top: 16px;
	}

	.current-overview h2 {
		margin-bottom: 4px;
	}

	.current-overview section > p {
		margin-top: 8px;
	}
</style>
