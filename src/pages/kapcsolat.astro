---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
	title="Kapcsolat | Antikapitalista Liga Magyarország"
	description="Kapcsolatfelvétel az Antikapitalista Liga Magyarországgal."
	brandTone="rust"
>
	<header>
			<h1 class="main-page-title">Kapcsolat</h1>
			<p>Kérdésed vagy javaslatod van? Kapcsolódj be a közös gondolkodásba.</p>
		</header>

		<main>
			<p>Telegram: <a class="contact-link" href="https://t.me/antikapitalista_liga" target="_blank" rel="noopener noreferrer">https://t.me/antikapitalista_liga</a></p>
			<p>
				A közösségi részvételről és a közös kezdeményezésekről a Közösség oldalon
				olvashatsz.
			</p>
		</main>
</MainLayout>

<style>
	.contact-link {
		color: var(--color-rust);
		text-decoration: none;
	}

	.contact-link:visited {
		color: var(--color-bronze);
	}
</style>
