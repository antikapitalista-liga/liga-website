---
import MainLayout from "../layouts/MainLayout.astro";
import ChapterControls from "../components/ChapterControls.astro";
import DocumentColophon from "../components/DocumentColophon.astro";
import chapters from "../data/constitution.json";
---

<MainLayout
	title="Pártalkotmány | Antikapitalista Liga Magyarország"
	description="Az Antikapitalista Liga Magyarország pártalkotmánya."
	brandTone="bronze"
>
	<header class="constitution-header" id="constitution-top">
		<div class="constitution-parent"><a href="/kuldetes/">Küldetés</a></div>
		<h1 class="constitution-title">Pártalkotmány</h1>
	</header>

	<main>
		<article class="constitution-copy">
			{chapters.map((chapter, index) => (
				<section aria-labelledby={chapter.id}>
					<h2 class="document-chapter-heading" id={chapter.id}>{chapter.title}<ChapterControls previous={chapters[index - 1]?.id} next={chapters[index + 1]?.id} /></h2>
					{chapter.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				</section>
			))}
		</article>
		<DocumentColophon />
	</main>
</MainLayout>

<style>
	.constitution-header {
		padding-bottom: 0;
		scroll-margin-top: var(--site-nav-height);
	}

	.constitution-title {
		margin: 20px 0 0;
	}

	.constitution-copy {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}

	:global(.constitution-copy p) {
		max-width: 84ch;
	}

	.constitution-copy h2 {
		scroll-margin-top: calc(var(--site-nav-height) + 16px);
	}

	@media (max-width: 760px) {
		.constitution-header,
		.constitution-copy h2 {
			scroll-margin-top: 120px;
		}
	}
</style>
