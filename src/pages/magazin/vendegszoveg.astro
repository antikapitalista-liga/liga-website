---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
	title="Vendégszöveg | Magazin | Antikapitalista Liga Magyarország"
	description="Vendégszövegek az Antikapitalista Liga Magyarország magazinjában."
	theme="magazine"
>
	<header class="current-category-header">
		<h1 id="current-category-title">
			Magazin: Vendégszöveg
			<a class="current-category-back" href="/magazin/" aria-label="Vissza a Magazin áttekintő oldalára">↑↑</a>
		</h1>
	</header>
	<main>
		<section aria-labelledby="current-category-title">
			<p>A rovat készülőben van.</p>
		</section>
	</main>
</MainLayout>

<style>
	.current-category-header h1 {
		margin-bottom: 0;
	}
</style>
