---
import MainLayout from "../../layouts/MainLayout.astro";
import MagazineArticle from "../../components/MagazineArticle.astro";
import { tarcak } from "../../data/tarcak";
---

<MainLayout
	title="Tárca | Magazin | Antikapitalista Liga Magyarország"
	description="Tárcák az Antikapitalista Liga Magyarország magazinjában."
	theme="magazine"
>
	<header class="current-category-header">
		<h1 id="current-category-title">
			Magazin: Tárca
			<a class="current-category-back" href="/magazin/" aria-label="Vissza a Magazin áttekintő oldalára">↑↑</a>
		</h1>
	</header>
	<main>
		<section aria-labelledby="current-category-title">
			{tarcak.length === 0 ? (
				<p>A rovat készülőben van.</p>
			) : (
				tarcak.map((article) => <MagazineArticle article={article} linkTitle />)
			)}
		</section>
	</main>
</MainLayout>

<style>
	.current-category-header h1 {
		margin-bottom: 0;
	}
</style>
