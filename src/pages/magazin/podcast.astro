---
import MainLayout from "../../layouts/MainLayout.astro";
import MagazineParent from "../../components/MagazineParent.astro";
---

<MainLayout
	title="Podcast | Magazin | Antikapitalista Liga Magyarország"
	description="Beszélgetések és podcastok az Antikapitalista Liga Magyarország magazinjában."
	theme="magazine"
>
	<header>
		<MagazineParent />
		<h1>Podcast</h1>
		<p>
			Beszélgetések társadalmi, gazdasági és kulturális kérdésekről, közérthetően és több
			szempontból megvizsgálva.
		</p>
	</header>
	<main>
		<p>
			A podcastrovat készülőben van. Az első adások megjelenésekor itt lesznek elérhetők a
			beszélgetések.
		</p>
	</main>
</MainLayout>
