---
import MainLayout from "../../../layouts/MainLayout.astro";
import MagazineParent from "../../../components/MagazineParent.astro";
import CurrentAnnouncement from "../../../components/CurrentAnnouncement.astro";
import CurrentCategoryDescription from "../../../components/CurrentCategoryDescription.astro";
import MagazineArticle from "../../../components/MagazineArticle.astro";
import { aktualisCategories, articlesByCategory, sortArticlesByDate } from "../../../data/aktualis";

export function getStaticPaths() {
	return aktualisCategories.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;
const articles = sortArticlesByDate(articlesByCategory[category.slug] ?? []);
---

<MainLayout
	title={`${category.label} | Aktuális | Magazin | Antikapitalista Liga Magyarország`}
	description={`${category.label} az Antikapitalista Liga Magyarország magazinjában.`}
	theme="magazine"
>
	<header class="current-category-header">
		<MagazineParent />
		<h1 id="current-category-title">
			Aktuális: {category.label}
			<a class="current-category-back" href="/magazin/aktualis/" aria-label="Vissza az Aktuális áttekintő oldalára">↑↑</a>
		</h1>
		{category.description && <CurrentCategoryDescription text={category.description} />}
		{category.slug === "hirdetmenyek" && <CurrentAnnouncement />}
	</header>
	<main>
		<section aria-labelledby="current-category-title">
			{articles.length > 0 ? (
				articles.map((article) => <MagazineArticle article={article} linkTitle />)
			) : category.slug !== "hirdetmenyek" && category.slug !== "part-hirek" ? (
				<p>A rovat írásai hamarosan itt lesznek elérhetők.</p>
			) : null}
		</section>
	</main>
</MainLayout>

<style>
	.current-category-header h1 {
		margin-bottom: 0;
	}

</style>
