---
import MainLayout from "../../layouts/MainLayout.astro";
import MagazineParent from "../../components/MagazineParent.astro";
---

<MainLayout
	title="Irodalom | Magazin | Antikapitalista Liga Magyarország"
	description="Irodalmi szövegek és olvasmányok az Antikapitalista Liga Magyarország magazinjában."
	theme="magazine"
>
	<header>
		<MagazineParent />
		<h1>Irodalom</h1>
		<p>
			Irodalmi művek és olvasmányok, amelyek az emberi méltóság, a közösség és a társadalom
			kérdéseit járják körül.
		</p>
	</header>
	<main>
		<p>
			Az irodalmi rovat készülőben van. Hamarosan itt jelennek meg a rovat szövegei és
			olvasmányajánlói.
		</p>
	</main>
</MainLayout>
