---
import MainLayout from "../../layouts/MainLayout.astro";
import MagazineArticle from "../../components/MagazineArticle.astro";
import { esszek } from "../../data/esszek";
import { sortArticlesByDate } from "../../data/aktualis";

// A kisesszék listáján a legutóbb megjelent írás kerül legfelülre.
const essaysInDateOrder = sortArticlesByDate(esszek);
---

<MainLayout
	title="Kisesszé | Magazin | Antikapitalista Liga Magyarország"
	description={essaysInDateOrder[0].subtitle}
	theme="magazine"
>
	<header class="current-category-header">
		<h1 id="current-category-title">
			Magazin: Kisesszé
			<a class="current-category-back" href="/magazin/" aria-label="Vissza a Magazin áttekintő oldalára">↑↑</a>
		</h1>
	</header>
	<main>
		<section aria-labelledby="current-category-title">
			{essaysInDateOrder.map((article) => <MagazineArticle article={article} linkTitle />)}
		</section>
	</main>
</MainLayout>

<style>
	.current-category-header h1 {
		margin-bottom: 0;
	}
</style>
