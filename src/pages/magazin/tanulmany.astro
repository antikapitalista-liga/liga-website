---
import MainLayout from "../../layouts/MainLayout.astro";
import MagazineArticle from "../../components/MagazineArticle.astro";
import { tanulmanyok } from "../../data/tanulmanyok";
import { sortArticlesByDate } from "../../data/aktualis";

// A tanulmányok listája mindig a legfrissebb megjelenéssel kezdődik.
const tanulmanyokInDateOrder = sortArticlesByDate(tanulmanyok);
---

<MainLayout
	title="Tanulmány | Magazin | Antikapitalista Liga Magyarország"
	description="Tanulmányok az Antikapitalista Liga Magyarország magazinjában."
	theme="magazine"
>
	<!-- A rovat fejlécéből a Magazin áttekintő oldalára lehet visszalépni. -->
	<header class="current-category-header">
		<h1 id="current-category-title">
			Magazin: Tanulmány
			<a class="current-category-back" href="/magazin/" aria-label="Vissza a Magazin áttekintő oldalára">↑↑</a>
		</h1>
	</header>
	<main>
		<!-- A tanulmányok teljes szövege a többi magazinrovattal azonos formában jelenik meg. -->
		<section aria-labelledby="current-category-title">
			{tanulmanyokInDateOrder.map((article) => <MagazineArticle article={article} linkTitle />)}
		</section>
	</main>
</MainLayout>

<style>
	/* A fejléc térköze megegyezik a többi magazinrovatéval. */
	.current-category-header h1 {
		margin-bottom: 0;
	}
</style>
