---
import SiteSearch from "./SiteSearch.astro";

interface Props {
	wide?: boolean;
	theme?: "magazine" | "current";
	lang?: "hu" | "en";
}

const { wide = false, theme, lang = "hu" } = Astro.props;
const currentPath = Astro.url.pathname;
const isMagazinePath = currentPath.startsWith("/magazin/");
const isCurrentPath = currentPath.startsWith("/aktualis/");
const items = [
	{ href: "/", label: "Főoldal" },
	{ href: "/kuldetes/", label: "Küldetés" },
	{ href: "/aktualis/", label: "Aktuális" },
	{ href: "/magazin/", label: "Magazin" },
	{ href: "/kozosseg/", label: "Közösség" },
	{ href: "/kapcsolat/", label: "Kapcsolat" },
	{ href: "/english/", label: "English" },
];
---
<nav
	id="top-of-page"
	class:list={[
		"site-navigation",
		wide && "site-navigation-wide",
		theme === "magazine" && "site-navigation-magazine",
		theme === "current" && "site-navigation-current",
	]}
	aria-label="Fő navigáció"
>
	<ul>
		{items.map((item) => (
			<li>
				<a
					href={item.href}
					aria-current={
						currentPath === item.href ||
						(item.href === "/magazin/" && isMagazinePath) ||
						(item.href === "/aktualis/" && isCurrentPath)
							? "page"
							: undefined
					}
				>
					{item.label}
				</a>
			</li>
		))}
	</ul>
	<SiteSearch lang={lang} />
</nav>
