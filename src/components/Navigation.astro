---
interface Props {
	wide?: boolean;
	magazine?: boolean;
}

const { wide = false, magazine = false } = Astro.props;
const currentPath = Astro.url.pathname;
const isMagazinePath = currentPath.startsWith("/magazin/");
const items = [
	{ href: "/", label: "Főoldal" },
	{ href: "/kuldetes/", label: "Küldetés" },
	{ href: "/magazin/", label: "Magazin" },
	{ href: "/kozosseg/", label: "Közösség" },
	{ href: "/kapcsolat/", label: "Kapcsolat" },
	{ href: "/english/", label: "English" },
];
---
<nav
	id="top-of-page"
	class:list={["site-navigation", wide && "site-navigation-wide", magazine && "site-navigation-magazine"]}
	aria-label="Fő navigáció"
>
	<ul>
		{items.map((item) => (
			<li>
				<a
					href={item.href}
					aria-current={
						currentPath === item.href || (item.href === "/magazin/" && isMagazinePath)
							? "page"
							: undefined
					}
				>
					{item.label}
				</a>
			</li>
		))}
	</ul>
</nav>
