---
interface Props {
	wide?: boolean;
}

const { wide = false } = Astro.props;
const currentPath = Astro.url.pathname;
const items = [
	{ href: "/", label: "Főoldal" },
	{ href: "/kuldetes/", label: "Küldetés" },
	{ href: "/velemeny/", label: "Vélemény" },
	{ href: "/irasok/", label: "Írások" },
	{ href: "/kozosseg/", label: "Közösség" },
	{ href: "/kapcsolat/", label: "Kapcsolat" },
	{ href: "/english/", label: "English" },
];
---
<nav
	id="top-of-page"
	class:list={["site-navigation", wide && "site-navigation-wide"]}
	aria-label="Fő navigáció"
>
	<ul>
		{items.map((item) => (
			<li>
				<a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
					{item.label}
				</a>
			</li>
		))}
	</ul>
</nav>
