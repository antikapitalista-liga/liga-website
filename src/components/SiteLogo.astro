---
interface Props {
	lang?: "hu" | "en";
}

const { lang = "hu" } = Astro.props;
---
<img
	class="site-logo"
	src="/ALMA-logo03-01.png"
	alt={lang === "en" ? "Anticapitalist League Hungary logo" : "Antikapitalista Liga Magyarország logója"}
/>

<style>
	.site-logo {
		display: block;
		width: 100%;
		max-width: 340px;
		height: auto;
		margin: 0 auto 10px;
	}

	@media (max-width: 1100px) {
		.site-logo {
			max-width: 280px;
		}
	}
</style>
