---
import { aktualisCategories, articlesByCategory, getRecentArticles } from "../data/aktualis";
import CurrentAnnouncement from "./CurrentAnnouncement.astro";
import CurrentCategoryDescription from "./CurrentCategoryDescription.astro";
import CurrentNews from "./CurrentNews.astro";

interface Props {
	lang?: "hu" | "en";
}

const { lang = "hu" } = Astro.props;
---

<ul class="current-links">
	{aktualisCategories.map((category) => (
		<li>
			<a href={`/magazin/aktualis/${category.slug}/`}>
				{lang === "en" ? category.englishLabel : category.label}
			</a>
			{(lang === "en" ? category.englishDescription : category.description) && (
				<CurrentCategoryDescription text={lang === "en" ? category.englishDescription : category.description} />
			)}
			{category.slug === "hirdetmenyek" && <CurrentAnnouncement lang={lang} />}
			{getRecentArticles(articlesByCategory[category.slug] ?? []).map((article) => (
				<CurrentNews article={article} />
			))}
		</li>
	))}
</ul>
