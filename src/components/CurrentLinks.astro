---
import { aktualisCategories, articlesByCategory, getRecentArticles } from "../data/aktualis";
import CurrentNews from "./CurrentNews.astro";

interface Props {
	lang?: "hu" | "en";
}

const { lang = "hu" } = Astro.props;
---

<ul class="current-links">
	{aktualisCategories.map((category) => (
		<li>
			<a href={`/aktualis/${category.slug}/`}>
				{lang === "en" ? category.englishLabel : category.label}
			</a>
			{getRecentArticles(articlesByCategory[category.slug] ?? [], 3).map((article) => (
				<CurrentNews article={article} compact />
			))}
		</li>
	))}
</ul>
