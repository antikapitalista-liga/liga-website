---
import { aktualisCategories } from "../data/aktualis";
import CurrentCategoryDescription from "./CurrentCategoryDescription.astro";
import CurrentNews from "./CurrentNews.astro";

interface Props {
	lang?: "hu" | "en";
}

const { lang = "hu" } = Astro.props;
---

<ul class="current-links">
	{aktualisCategories.map((category) => (
		<li>
			<a href={`/magazin/aktualis/${category.slug}/`}>
				{lang === "en" ? category.englishLabel : category.label}
			</a>
			<CurrentCategoryDescription text={lang === "en" ? category.englishDescription : category.description} />
			{category.slug === "part-hirek" && (
				<CurrentNews />
			)}
		</li>
	))}
</ul>
