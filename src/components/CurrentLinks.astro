---
import {
	aktualisCategories,
	articlesByCategory,
	getRecentArticles,
	sortCategoriesByLatestArticle,
} from "../data/aktualis";
import CurrentNews from "./CurrentNews.astro";

interface Props {
	lang?: "hu" | "en";
}

const { lang = "hu" } = Astro.props;

// A rovatlinkek is a legfrissebb cikket tartalmazó rovatot mutatják először.
const categoriesInDateOrder = sortCategoriesByLatestArticle(
	aktualisCategories.map((category) => ({
		...category,
		articles: articlesByCategory[category.slug] ?? [],
	})),
);
---

<ul class="current-links">
	{categoriesInDateOrder.map((category) => (
		<li>
			<a href={`/aktualis/${category.slug}/`}>
				{lang === "en" ? category.englishLabel : category.label}
			</a>
			{getRecentArticles(category.articles, 3).map((article) => (
				<CurrentNews article={article} compact />
			))}
		</li>
	))}
</ul>
