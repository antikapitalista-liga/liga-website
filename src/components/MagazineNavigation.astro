---
const categories = [
	{ href: "/magazin/velemeny/", label: "Vélemény" },
	{ href: "/magazin/essze/", label: "Esszé" },
	{ href: "/magazin/irodalom/", label: "Irodalom" },
	{ href: "/magazin/vendegszoveg/", label: "Vendégszöveg" },
	{ href: "/magazin/podcast/", label: "Podcast" },
	{ href: "/magazin/aktualis/", label: "Aktuális" },
];
---
<nav class="magazine-navigation" aria-label="Magazin rovatok">
	<ul class="current-links">
		{categories.map((category) => (
			<li><a href={category.href}>{category.label}</a></li>
		))}
	</ul>
</nav>
