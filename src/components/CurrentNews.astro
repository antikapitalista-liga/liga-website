---
import type { Article } from "../data/aktualis";

interface Props {
	article: Article;
}

const { article } = Astro.props;
---

<div class="current-news" lang="hu">
	<a href={article.url}>
		<span class="current-article-title">{article.title}</span>
		<strong>{article.subtitle}</strong>
	</a>
</div>

<style>
	.current-news {
		margin: 8px 0 12px 12px;
	}

	.current-news a {
		display: block;
	}

	.current-news .current-article-title {
		display: block;
		text-transform: lowercase;
	}

	.current-news .current-article-title::first-letter {
		text-transform: uppercase;
	}

	.current-news strong {
		display: block;
		margin-top: 4px;
		font-family: "Special Elite", "Segoe UI", sans-serif;
		font-size: 0.9rem;
		line-height: 1.5;
		text-transform: none;
	}
</style>
