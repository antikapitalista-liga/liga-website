---
import { documentColophon } from "../data/documentColophon";
---

<footer class="document-colophon">
	<p class="document-author">{documentColophon.author}</p>
	<p class="document-place-date">{documentColophon.placeDate}</p>
	<p class="document-last-modified">{documentColophon.lastModified}</p>
</footer>

<style>
	.document-colophon {
		margin-top: 32px;
		color: #5a3c1e;
	}

	.document-colophon p {
		margin-bottom: 4px;
	}

	.document-author {
		font-weight: 600;
	}

	.document-last-modified {
		font-size: 0.85rem;
	}
</style>
