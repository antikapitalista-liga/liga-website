---
interface Props {
	previous?: string;
	next?: string;
	top?: string;
}

const { previous, next, top = "constitution-top" } = Astro.props;
---
<span class="chapter-controls" role="group" aria-label="Fejezetnavigáció">
	{previous && <a href={`#${previous}`} aria-label="Ugrás az előző fejezetre">↑</a>}
	{next && <a href={`#${next}`} aria-label="Ugrás a következő fejezetre">↓</a>}
	<a href={`#${top}`} aria-label="Ugrás a dokumentum elejére">↑↑</a>
</span>

<style>
	.chapter-controls {
		display: inline-flex;
		gap: 0.35em;
		margin-left: 1em;
		white-space: nowrap;
		font-family: "Crayon Libre", "Calibri Light", "Segoe UI Light", sans-serif;
		font-size: 0.75em;
	}

	.chapter-controls a {
		padding: 0 0.2em;
		border-radius: 4px;
		color: inherit;
		text-decoration: none;
	}

	.chapter-controls a:hover {
		background: rgb(0 0 0 / 12%);
	}
</style>
