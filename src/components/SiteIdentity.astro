---
import SiteLogo from "./SiteLogo.astro";

interface Props {
	lang?: "hu" | "en";
	showExternalLinks?: boolean;
}

const { lang = "hu", showExternalLinks = true } = Astro.props;
---
<div class="site-identity">
	<SiteLogo lang={lang} />
	<blockquote class="site-motto">
		<p>{lang === "en"
			? "“We cannot solve our problems with the same thinking we used when we created them.”"
			: "„Egy problémát nem lehet ugyanazzal a gondolkodásmóddal megoldani, amellyel létrehoztuk.”"}</p>
		<cite>{lang === "en" ? "Attributed to Albert Einstein" : "Albert Einstein"}</cite>
	</blockquote>
	<p class="site-note">
		{lang === "en"
			? "The website is currently under development, ahead of the party's official formation."
			: "A webhely jelenleg fejlesztés alatt, a párt hivatalos megalakulása előtt áll."}
	</p>
	{showExternalLinks && (
		<nav class="site-external-links" aria-label={lang === "en" ? "External community links" : "Külső közösségi hivatkozások"}>
			{lang !== "en" && (
				<a href="https://forms.cloud.microsoft/r/4VUADGHw0U?origin=lprLink">
					Előjelentkezési kérdőív tagsághoz
				</a>
			)}
			<a href="https://www.facebook.com/antikapitalista.liga/">
				{lang === "en" ? "Facebook community" : "Facebook közösség"}
			</a>
		</nav>
	)}
	<slot />
</div>

<style>
	.site-motto {
		margin: 15px 0 0;
		color: var(--color-gold);
		font-size: 1rem;
		font-style: italic;
		line-height: 1.6;
	}

	.site-motto p {
		max-width: none;
		margin: 0;
	}

	.site-motto cite {
		display: block;
		margin-top: 10px;
		color: var(--color-moss-light);
		font-style: normal;
	}

	.site-note {
		margin-top: 28px;
		padding-top: 18px;
		border-top: 1px solid rgb(255 255 255 / 15%);
		color: rgb(255 255 255 / 72%);
		font-size: 0.9rem;
		font-style: italic;
		line-height: 1.6;
	}

	.site-external-links {
		margin-top: 30px;
	}

	.site-external-links a {
		display: block;
		margin-bottom: 16px;
		color: var(--color-moss-light);
		font-size: 1.05rem;
		text-decoration: none;
	}

	.site-external-links a:hover {
		text-decoration: underline;
	}

	@media (max-width: 1100px) {
		.site-note,
		.site-external-links {
			max-width: 500px;
			margin-inline: auto;
		}

		.site-external-links {
			margin-top: 24px;
		}
	}
</style>
